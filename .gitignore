# Build output — regenerated by build/influencer_catalogue.py + catalogue_dist.py.
site/
dist/
__pycache__/

# The source workbook: 162 creators' names, handles, follower counts and the
# tier pricing. Deliberately not in this repo — it is fetched when a build
# needs it, and this repo is public.
Influncer Proposal Catalogue/

# The admin service's data, if anyone ever runs it from inside a checkout.
admin/catalogue.db
admin/catalogue.db-*
admin/.secret

# The photo-link signing key. nginx checks every creator photograph against it,
# so committing it to a public repository would make every link forgeable —
# which is the entire point of signing them. Provisioned by deploy, never here.
admin/.photo-secret
deploy/catalogue/secret.conf
