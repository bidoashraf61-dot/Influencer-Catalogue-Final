# Identity key: code -> name / handle / exact followers. Never commit.
content/catalogue_private.json
content/_harvest.json
.DS_Store
admin/catalogue.db
admin/catalogue.db-wal
admin/catalogue.db-shm
admin/.secret

# Build output — regenerated by build/influencer_catalogue.py + catalogue_dist.py.
site/
dist/
__pycache__/

# The source workbook: 162 creators' names, handles, follower counts and the
# tier pricing. Deliberately not in this repo — it is fetched when a build
# needs it, and this repo is public.
Influncer Proposal Catalogue/

# The admin service's data, if anyone ever runs it from inside a checkout.
admin/catalogue.db
admin/catalogue.db-*
admin/.secret

# The photo-link signing key. nginx checks every creator photograph against it,
# so committing it to a public repository would make every link forgeable —
# which is the entire point of signing them. Provisioned by deploy, never here.
admin/.photo-secret

# Country lookup for tracking-link clicks, built on the server from the DB-IP
# Lite CSV (python3 admin/track.py --geo-build …). Large and regenerated.
admin/geo.db
admin/geo.db.tmp

# Insight screenshots creators upload for campaigns — client data.
admin/insight_files/
deploy/catalogue/secret.conf

# Undo bin: photographs of deleted creators, kept so a restore brings them
# back. Creator data — never in this public repository.
admin/trash/

# Post thumbnails fetched from Instagram/TikTok for campaign reports — client data.
admin/post_thumbs/
admin/analysis_media/
admin/analysis_pending/
admin/_vendor/

# Apify API token. Entered on the APIs page, kept on the server only.
admin/.apify-token
